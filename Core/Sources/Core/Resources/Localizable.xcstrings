    "Message.BiometricUnlock" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, Willow uses %@ to unlock when you return to the app."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启后，Willow 会在返回前台时使用 %@ 解锁。"
          }
        }
      }
    },
    "Message.ChapterHasNoPages" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chapter “%@” has no downloadable pages."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "章节“%@”没有可下载的页面。"
          }
        }
      }
    },
    "Message.DownloadChaptersForOfflineReading" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download chapters from comic details to read offline."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以在漫画详情中下载章节，方便离线阅读。"
          }
        }
      }
    },
    "Message.DownloadChaptersFromAComicSDetailPageToReadThemOffline" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download chapters from a comic’s detail page to read them offline."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以在漫画详情中下载章节，方便离线阅读。"
          }
        }
      }
    },
    "Message.EnterAnExistingOrNewCollectionNameLeaveItBlankToRemoveTheComicFromItsCollection" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter an existing or new collection name. Leave it blank to remove the comic from its collection."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "填写现有或新的分组名称。留空会移出分组。"
          }
        }
      }
    },
    "Message.EnterTheLinkToThePluginFilePluginsCanAccessTheNetworkSoOnlyInstallPluginsFromSourcesYouTrust" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter the link to the plugin file. Plugins can access the network, so only install plugins from sources you trust."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入插件文件的链接。插件能从网络读取内容，请只安装来自可信来源的插件。"
          }
        }
      }
    },
    "Message.ICloudSyncScope" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your library, reading history, plugins, subscriptions, and tags sync through iCloud. Plugin sign-in settings and downloaded images stay on this device."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "书架、阅读历史、插件、订阅和标签通过 iCloud 同步。插件登录配置和下载图片仅保留在本机。"
          }
        }
      }
    },
    "Message.LocalPagesAreMissingDeleteThisDownloadAndDownloadTheComicAgain" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Local pages are missing. Delete this download and download the comic again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到本地页面。请删除这个下载，然后重新下载漫画。"
          }
        }
      }
    },
