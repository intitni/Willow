{
  "sourceLanguage": "en",
  "strings": {
    "Text.EnableBiometricProtectionForYourWillowLibrary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable biometric protection for your Willow library."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为 Willow 书架开启生物识别保护。"
          }
        }
      }
    },
    "Text.TurnOffProtectionForYourWillowLibrary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off protection for your Willow library."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭 Willow 书架的保护。"
          }
        }
      }
    },
    "Text.ThisBuildCanTAccessItsICloudContainer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build can’t access its iCloud container."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前构建没有访问 iCloud 容器的权限。"
          }
        }
      }
    },
    "Text.ThisChapterHasNoPagesToDownload": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This chapter has no pages to download."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此章节没有可下载的图片。"
