{
  "sourceLanguage": "en",
  "strings": {
    "DriveSync.FolderAlreadyExists": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This folder already contains sync files. Connect it using its original recovery key."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件夹已有同步文件，请使用原来的恢复密钥连接。"
          }
        }
      }
    },
    "DriveSync.WaitingForFiles": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Willow is waiting for iCloud Drive to download the sync files. Try again when the download finishes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Willow 正在等待 iCloud 云盘下载同步文件，请在下载完成后重试。"
          }
        }
      }
    },
    "DriveSync.InvalidKey": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the recovery key generated by Willow."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入 Willow 生成的恢复密钥。"
          }
        }
      }
    },
    "DriveSync.WrongKey": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This folder is already set up or the recovery key doesn’t match. Use the key from the device that created the folder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件夹已设置同步，或恢复密钥不匹配。请使用创建同步文件夹的设备上的密钥。"
          }
        }
      }
    },
    "DriveSync.MissingDirectory": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The encrypted folder is unavailable. Wait for iCloud Drive or choose the folder again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加密同步文件夹暂不可用。请等待 iCloud 云盘完成下载，或重新选择文件夹。"
          }
        }
      }
    },
    "DriveSync.DirectoryChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sync folder has changed. Select it again to reconnect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步文件夹已变更。请重新选择文件夹以恢复连接。"
          }
        }
      }
    },
    "DriveSync.KeychainError": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Willow couldn’t access the sync recovery key in Keychain."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Willow 无法访问钥匙串中的同步恢复密钥。"
          }
        }
      }
    },
    "AppLock.EnableReason": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable biometric protection for your Willow library."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为 Willow 书架开启生物识别保护。"
          }
        }
      }
    },
    "AppLock.DisableReason": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off protection for your Willow library."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭 Willow 书架的保护。"
          }
        }
      }
    },
    "Downloads.EmptyChapter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This chapter has no pages to download."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此章节没有可下载的图片。"
          }
        }
      }
    },
    "Biometrics.GenericName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "biometrics"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生物识别"
          }
        }
      }
    },
    "AppLock.UnlockReason": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock your Willow library."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁 Willow 书架。"
          }
        }
      }
    },
    "Downloads.FileOperationInProgress": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download files are being updated. Please try again shortly."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在处理此下载的文件，请稍后重试。"
          }
        }
      }
    },
    "LocalTags.NameRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a tag name."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入标签名称。"
          }
        }
      }
    },
    "Biometrics.FaceID": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID"
          }
        }
      }
    },
    "Biometrics.TouchID": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch ID"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch ID"
          }
        }
      }
    },
    "Biometrics.OpticID": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optic ID"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Optic ID"
          }
        }
      }
    },
    "Licenses.SourceCode": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Corresponding Source Code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对应版本源码"
          }
        }
      }
    },
    "Licenses.BundledLicenseNotices": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Third-Party License Notices"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第三方许可声明"
          }
        }
      }
    }
  },
  "version": "1.0"
}
