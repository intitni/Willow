    },
    "Message.DownloadFileOperationInProgress": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download files are being updated. Please try again shortly."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在处理此下载的文件，请稍后重试。"
          }
        }
      }
    },
